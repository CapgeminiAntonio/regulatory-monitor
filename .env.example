# Copy to .env and fill in. Never commit .env.

# Which LLM backend to use: "gateway" (Capgemini AI Passport Gateway) or "anthropic" (Anthropic API directly)
LLM_PROVIDER=gateway

# Capgemini AI Passport Gateway (OpenAI-compatible Responses API). Keys rotate every 90 days.
GATEWAY_API_KEY=sk-...
GATEWAY_MODEL=anthropic.claude-opus-5-5
# GATEWAY_BASE_URL=https://openai.generative-eu.engine.capgemini.com/v1   # EU data residency

# Anthropic API directly (only when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# true = ingest from data/fixtures (offline-safe demo); false = pull live feeds
DEMO_MODE=false
SCAN_DAY_OF_WEEK=mon
SCAN_HOUR=7
ENABLE_SCHEDULER=true
MAX_ITEMS_PER_SOURCE=10
LOOKBACK_DAYS=150
